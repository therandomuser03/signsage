# Runtime
SIGNSAGE_ENV=development
SIGNSAGE_HOST=0.0.0.0
SIGNSAGE_PORT=8000
SIGNSAGE_DEVICE=auto

# Paths
SIGNSAGE_MODEL_DIR=./weights
SIGNSAGE_TEXT_VOCAB=./vocab/token_vocabulary.json
SIGNSAGE_GLOSS_VOCAB=./vocab/gloss_vocabulary.json
SIGNSAGE_MANIFEST=./signsage_knowledge_manifest.json

# Model/input limits
SIGNSAGE_MAX_FRAMES=160
SIGNSAGE_MAX_TOKENS=40
SIGNSAGE_POSE_OUTPUT_FRAMES=60
SIGNSAGE_MAX_WEBSOCKET_FRAMES=300
SIGNSAGE_MAX_TEXT_CHARS=2000
SIGNSAGE_MAX_WS_MESSAGE_BYTES=1000000

# The official API contract expects training-compatible normalized landmarks.
# Use "raw" only if the client sends raw MediaPipe image-space coordinates.
SIGNSAGE_LANDMARK_INPUT_MODE=normalized

# Frontend origins, comma separated
SIGNSAGE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional ablation model
SIGNSAGE_ALLOW_NOFACE=true

# Optional Groq glossing
SIGNSAGE_ENABLE_GROQ_GLOSS=false
SIGNSAGE_GROQ_API_KEY=
SIGNSAGE_GROQ_MODEL=openai/gpt-oss-20b

# Optional local Ollama fallback
SIGNSAGE_ENABLE_OLLAMA_GLOSS=false
SIGNSAGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
SIGNSAGE_OLLAMA_MODEL=llama3.2:3b
SIGNSAGE_OLLAMA_TIMEOUT_SECONDS=8

# Optional Supabase auth (frontend guards translator by default; enable to verify WS token server-side)
SIGNSAGE_ENABLE_AUTH=false
SIGNSAGE_SUPABASE_URL=
SIGNSAGE_SUPABASE_ANON_KEY=

# Functional demo fallback for collapsed Sign→Text (Image 1 fix)
SIGNSAGE_ENABLE_DEMO_FALLBACK=true
SIGNSAGE_DEMO_PROTOTYPES_DIR=./demo_prototypes
SIGNSAGE_DEMO_MATCH_THRESHOLD=6.5
SIGNSAGE_TRANSLATION_CONFIDENCE_THRESHOLD=0.45

# LLM sentence refinement for Sign→Text (groq→ollama→naive)
SIGNSAGE_ENABLE_LLM_REFINE=false
SIGNSAGE_LLM_REFINE_TIMEOUT_SECONDS=8
