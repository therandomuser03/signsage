# SignSage Backend Environment
# Copy to backend/.env. Never commit backend/.env.

# ===== Sign-to-Text Model =====
SIGNSAGE_MODEL_BUNDLE_DIR=../research/artifacts/352868924/signsage_deployment_bundle
SIGNSAGE_MODEL_PROMOTED=false
# Local-dev only: serve the configured checkpoint even though it has not
# passed the deployment gate. NEVER enable in production.
SIGNSAGE_ALLOW_UNPROMOTED_DEV=false
SIGNSAGE_MODEL_VERSION=signsage-s2t
SIGNSAGE_DEVICE=cpu
# Checkpoint-free fallback: rule-based recognition of 5 static one-hand
# shapes (HELLO/YES/NO/YOU/HELP), served when the transformer is gated and
# always reported as "heuristic-fallback" via /capabilities. Safe to leave on.
SIGNSAGE_FALLBACK_ENABLED=true

# Inference guards
SIGNSAGE_MIN_MOTION_ENERGY=0.002
SIGNSAGE_MIN_CONFIDENCE=0.0
SIGNSAGE_MAX_FRAMES_PER_SEQUENCE=160
SIGNSAGE_MAX_MESSAGE_BYTES=262144

# Rolling (streaming) inference: interim translations run on the trailing
# window every stride frames (~10 landmark frames/s in, ~50-70 ms per
# inference on CPU). Window must stay <= MAX_FRAMES_PER_SEQUENCE.
SIGNSAGE_STREAM_WINDOW_FRAMES=80
SIGNSAGE_STREAM_STRIDE_FRAMES=20

# ===== Supabase Auth / History =====
SIGNSAGE_SUPABASE_URL=
SIGNSAGE_SUPABASE_PUBLISHABLE_KEY=
SIGNSAGE_AUTH_REQUIRED=false
SIGNSAGE_AUTH_CACHE_TTL_SECONDS=30

# ===== Translation History =====
SIGNSAGE_HISTORY_ENABLED=true
# Allowed: supabase | memory
SIGNSAGE_HISTORY_BACKEND=supabase

# ===== English-to-ISL Gloss Generation =====
SIGNSAGE_GROQ_API_KEY=
SIGNSAGE_GROQ_MODEL=llama-3.3-70b-versatile
SIGNSAGE_GROQ_BASE_URL=https://api.groq.com/openai/v1
SIGNSAGE_GROQ_TIMEOUT_SECONDS=6.0

# Optional local Ollama fallback
SIGNSAGE_OLLAMA_BASE_URL=
SIGNSAGE_OLLAMA_MODEL=llama3.2
SIGNSAGE_OLLAMA_TIMEOUT_SECONDS=6.0

# ===== Server =====
# Note: the process port comes from $PORT (see Dockerfile/Render), not Settings.
SIGNSAGE_CORS_ORIGINS=["http://localhost:5173"]
SIGNSAGE_LOG_LEVEL=INFO