# ===== Sign->Text model (see app/core/config.py; every var is prefixed SIGNSAGE_) =====
# Directory of the notebook's exported signsage_deployment_bundle/ (checkpoint/, tokenizer/, *.json).
SIGNSAGE_MODEL_BUNDLE_DIR=research/artifacts/352868924/signsage_deployment_bundle
# MUST stay false until a run's evaluation_results.json passes the deployment gate.
# Run 352868924 is NO-GO (see backend/models/README.md). While false, live translation refuses to serve.
SIGNSAGE_MODEL_PROMOTED=false
SIGNSAGE_MODEL_VERSION=signsage-s2t
SIGNSAGE_DEVICE=cpu
SIGNSAGE_MIN_MOTION_ENERGY=0.002
SIGNSAGE_MIN_CONFIDENCE=0.0
SIGNSAGE_MAX_FRAMES_PER_SEQUENCE=160
SIGNSAGE_MAX_SEQUENCE_SECONDS=12.0
SIGNSAGE_MAX_MESSAGE_BYTES=262144

# ===== Auth (Supabase Auth owns identity). Use the SAME project as the frontend's VITE_SUPABASE_* =====
# Leave both empty to run guest-only. Use the public publishable/anon key -- never a service-role key.
SIGNSAGE_SUPABASE_URL=
SIGNSAGE_SUPABASE_PUBLISHABLE_KEY=
# false: guests may translate; signed-in users additionally get history. true: sign-in required.
SIGNSAGE_AUTH_REQUIRED=false
SIGNSAGE_AUTH_CACHE_TTL_SECONDS=30

# ===== History (needs migrations/001_translation_sessions.sql applied in Supabase) =====
SIGNSAGE_HISTORY_ENABLED=true
# "supabase" (production) | "memory" (local dev only: lost on restart)
SIGNSAGE_HISTORY_BACKEND=supabase

# ===== Avatar gloss generation (English->ISL). Groq -> Ollama -> deterministic. =====
# All three stages return the same shape and only ever choose among the SAME
# fixed sign vocabulary (app/data/sign_vocabulary.json) -- an LLM here means
# better PHRASING coverage of your 14 existing signs, not new signs.
# Leave both empty to use only the deterministic word-lookup (always works, no network).

# Free at console.groq.com/keys. Get a key, paste it below, done -- no other setup.
SIGNSAGE_GROQ_API_KEY=
SIGNSAGE_GROQ_MODEL=llama-3.3-70b-versatile
SIGNSAGE_GROQ_BASE_URL=https://api.groq.com/openai/v1
SIGNSAGE_GROQ_TIMEOUT_SECONDS=6.0

# Local fallback: install Ollama (ollama.com), `ollama pull llama3.2`, `ollama serve`.
# Only used if Groq is unset OR fails/rate-limits (see backend/models/README.md).
SIGNSAGE_OLLAMA_BASE_URL=
SIGNSAGE_OLLAMA_MODEL=llama3.2
SIGNSAGE_OLLAMA_TIMEOUT_SECONDS=6.0

# ===== Server =====
SIGNSAGE_HOST=0.0.0.0
SIGNSAGE_PORT=8000
# JSON list. Must include your frontend origin(s), e.g. your Vercel URL.
SIGNSAGE_CORS_ORIGINS=["http://localhost:5173"]
SIGNSAGE_LOG_LEVEL=INFO
