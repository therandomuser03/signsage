# SignSage Frontend Environment
# Copy to `.env.local` and fill in what you need. Never commit `.env.local`.
# All values are public (bundled into the browser build) — service-role keys
# and other secrets MUST NOT go here.

# REST + derived WebSocket base (default: http://localhost:8000).
# Production (Vercel): https://<actual-render-service>.onrender.com
VITE_SIGNSAGE_API_URL=http://localhost:8000

# Optional explicit WebSocket URL. When unset it is derived from
# VITE_SIGNSAGE_API_URL as <ws(s)>://<host>/ws/translate (wss under https).
# Production: wss://<actual-render-service>.onrender.com/ws/translate
# VITE_SIGNSAGE_WS_URL=

# Optional Supabase auth (guest mode works without these).
# Use the public publishable key only — never the service-role key.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
