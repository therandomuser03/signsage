# Backend (FastAPI). Local default shown; in production use your Render URL.
VITE_SIGNSAGE_API_URL=http://localhost:8000
# Optional: if unset it is derived from the API URL (http->ws, /ws/translate).
VITE_SIGNSAGE_WS_URL=ws://localhost:8000/ws/translate

# Supabase Auth (optional: leave empty to run guest-only).
# The backend needs the SAME project: SIGNSAGE_SUPABASE_URL / SIGNSAGE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# NOTE: never put DATABASE_URL / service-role keys in the frontend.
