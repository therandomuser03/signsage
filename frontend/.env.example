# Required in production. Set to the Render backend WebSocket URL, for example:
# wss://your-render-service.onrender.com/api/v1/ws/translate
VITE_SIGNSAGE_WS_URL=ws://127.0.0.1:8000/api/v1/ws/translate

# Optional. Defaults to MediaPipe's hosted Holistic Landmarker model.
# Set this to a locally hosted `.task` file for offline development.
VITE_MEDIAPIPE_MODEL_URL=

# Supabase (used for optional account auth / session history sync).
# Get these from your own Supabase project's API settings.
# SECURITY: the ORIGINAL uploaded project had a real Supabase project's
# anon key AND a Postgres DATABASE_URL/DIRECT_URL with a plaintext password
# committed to frontend/.env.local. Both have been removed from this
# delivered copy. Rotate that database password and anon key in the
# Supabase dashboard, then fill in your own values below.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only needed if you run Prisma/Drizzle-style migrations against Supabase
# Postgres directly. Get a fresh connection string (with a rotated
# password) from Supabase -> Project Settings -> Database.
DATABASE_URL=
DIRECT_URL=
