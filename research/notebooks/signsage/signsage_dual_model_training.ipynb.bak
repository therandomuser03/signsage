   "metadata": {},
   "source": [
    "## 5. Model B: aligned pose-to-English data\n",
    "\n",
    "GloSL uses its published `train/dev/test` split only after verifying `video_ref` disjointness. iSign and canonical manifests split by source video; complete signer IDs take precedence. `MAX_SAMPLES_PER_SPLIT` bounds Kaggle work and keeps the selected subset deterministic."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "translation-data-functions",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _pose_path_index(root):\n",
    "    root = Path(root)\n",
    "    if not root.is_dir():\n",
    "        raise FileNotFoundError(f\"Pose root not found: {root}\")\n",
    "    index = {}\n",
    "    for path in root.rglob(\"*\"):\n",
    "        if path.is_file() and path.suffix.lower() in (\".pose\", \".npy\", \".npz\"):\n",
    "            index.setdefault(path.stem, path)\n",
    "    return index\n",
    "\n",
    "\n",
    "def _resolve_glosl_pose(value, root):\n",
    "    root = Path(root)\n",
    "    val_str = str(value).replace(\"\\\\\", \"/\")\n",
    "    # Direct path under root\n",
    "    direct = root / val_str\n",
    "    if direct.is_file():\n",
    "        return direct\n",
    "    # Under poses/ subdirectory\n",
    "    under_poses = root / \"poses\" / val_str\n",
    "    if under_poses.is_file():\n",
    "        return under_poses\n",
    "    # Stripped poses/ prefix if already present in value\n",
    "    if val_str.startswith(\"poses/\"):\n",
    "        stripped = root / val_str[6:]\n",
    "        if stripped.is_file():\n",
    "            return stripped\n",
    "    # Actionable failure\n",
    "    subdirs = [p.name for p in root.iterdir() if p.is_dir()] if root.exists() else []\n",
    "    raise FileNotFoundError(\n",
    "        f\"GloSL pose file not found: {value}\\n\"\n",
    "        f\"Attempted: {direct} and {under_poses}\\n\"\n",
    "        f\"TRANSLATION_POSE_ROOT={root.resolve()} (subdirs: {subdirs})\\n\"\n",
    "        f\"Ensure TRANSLATION_POSE_ROOT points to the root of the extracted GloSL dataset containing 'poses/'.\"\n",
    "    )\n",
    "\n",
    "\n",
    "def load_translation_records():\n",
    "    if TRANSLATION_MANIFEST is None:\n",
    "        raise ValueError(\"Set TRANSLATION_MANIFEST to attached annotations before enabling translation.\")\n",
    "    rows, fields = read_csv_rows(TRANSLATION_MANIFEST)\n",
    "    root = Path(TRANSLATION_POSE_ROOT)\n",
    "    show_input_tree(root, limit=10)\n",
    "    fmt = TRANSLATION_FORMAT\n",
    "    if fmt == \"auto\":\n",
    "        if {\"pose_file\", \"text\"}.issubset(fields):\n",
    "            fmt = \"glosl\"\n",
    "        elif {\"uid\", \"text\"}.issubset(fields):\n",
    "            fmt = \"isign\"\n",
    "        elif {\"pose_path\", \"text\"}.issubset(fields):\n",
    "            fmt = \"canonical\"\n",
    "        else:\n",
    "            raise ValueError(f\"Cannot infer translation format from fields {fields}; set TRANSLATION_FORMAT.\")\n",
    "    pose_index = None\n",
    "    records = []\n",
    "    for number, row in enumerate(rows, start=2):\n",
    "        text = str(row.get(\"text\", \"\")).strip()\n",
    "        if not text:\n",
    "            raise ValueError(f\"Translation row {number} has empty English target.\")\n",
    "        if fmt == \"glosl\":\n",
    "            value = row.get(\"pose_file\", \"\")\n",
    "            path = _resolve_glosl_pose(value, root)\n",
    "            video = str(row.get(\"video_ref\", \"\")).strip()\n",
    "            split_name = str(row.get(\"split\", \"\")).strip().lower()\n",
    "            signer = str(row.get(\"signer\", \"\")).strip()\n",
    "        elif fmt == \"isign\":\n",
    "            uid = str(row.get(\"uid\", \"\")).strip()\n",
    "            if not uid:\n",
    "                raise ValueError(f\"Translation row {number} has empty uid.\")\n",
    "            if pose_index is None:\n",
    "                pose_index = _pose_path_index(root)\n",
    "            path = pose_index.get(uid)\n",
    "            if path is None:\n",
    "                raise FileNotFoundError(f\"No attached pose file matches iSign uid {uid!r} in {root}.\")\n",
    "            # iSign UIDs are sample identifiers. Use explicit video_id/signer metadata if provided;\n",
    "            # otherwise treat each sample independently to avoid false assumptions.\n",
    "            video = str(row.get(\"video_id\", \"\")).strip() or uid\n",
    "            signer = str(row.get(\"signer\", \"\")).strip()\n",
    "            split_name = str(row.get(\"split\", \"\")).strip().lower()\n",
    "        elif fmt == \"canonical\":\n",
    "            path = resolve_input_path(row.get(\"pose_path\", \"\"), root)\n",
    "            video = str(row.get(\"video_id\", \"\")).strip()\n",
    "            split_name = str(row.get(\"split\", \"\")).strip().lower()\n",
    "            signer = str(row.get(\"signer\", \"\")).strip()\n",
    "        else:\n",
    "            raise ValueError(f\"Unsupported TRANSLATION_FORMAT={fmt!r}\")\n",
    "        if not video:\n",
    "            raise ValueError(f\"Translation row {number} lacks source video identity.\")\n",
    "        if not path.is_file():\n",
    "            raise FileNotFoundError(f\"Translation row {number} pose file missing: {path}\")\n",
    "        split_name = {\"dev\": \"validation\", \"val\": \"validation\"}.get(split_name, split_name)\n",
    "        records.append({\"path\": path, \"text\": text, \"video_id\": video, \"signer\": signer,\n",
    "                        \"official_split\": split_name, \"uid\": str(row.get(\"uid\") or row.get(\"id\") or number)})\n",
    "    print(f\"translation format={fmt}; aligned rows={len(records):,}; annotation fields={fields}\")\n",
    "    return records, fmt\n",
    "\n",
    "\n",
    "def assign_translation_splits(records):\n",
    "    signer_complete = all(row[\"signer\"] for row in records)\n",
    "    if signer_complete:\n",
    "        split = split_grouped(records, \"signer\")\n",
    "        policy = \"signer-independent\"\n",
    "    elif all(row[\"official_split\"] in (\"train\", \"validation\", \"test\") for row in records):\n",
    "        split = {name: [r for r in records if r[\"official_split\"] == name]\n",
    "                 for name in (\"train\", \"validation\", \"test\")}\n",
    "        policy = \"published source-video split; signer independence unavailable\"\n",
    "    else:\n",
    "        split = split_grouped(records, \"video_id\")\n",
    "        policy = \"source-video-independent; signer independence unavailable\"\n",
    "    video_sets = {name: {r[\"video_id\"] for r in rows} for name, rows in split.items()}\n",
    "    pairs = [(\"train\", \"validation\"), (\"train\", \"test\"), (\"validation\", \"test\")]\n",
    "    for left, right in pairs:\n",
    "        overlap = video_sets[left] & video_sets[right]\n",
    "        if overlap:\n",
    "            raise ValueError(f\"Video leakage between {left} and {right}: {len(overlap)} shared videos.\")\n",
    "    if signer_complete:\n",
    "        signer_sets = {name: {r[\"signer\"] for r in rows} for name, rows in split.items()}\n",
    "        for left, right in pairs:\n",
    "            if signer_sets[left] & signer_sets[right]:\n",
    "                raise ValueError(f\"Signer leakage between {left} and {right}.\")\n",
    "    print(f\"split policy: {policy}; \" + \"; \".join(f\"{k}={len(v):,}\" for k, v in split.items()))\n",
    "    return split, signer_complete, policy\n",
    "\n",
    "\n",
    "def load_translation_split(split_rows):\n",
    "    loaded, errors = [], []\n",
    "    for row in split_rows:\n",
    "        try:\n",
    "            landmarks = load_landmarks(row[\"path\"])\n",
    "            norm = normalize_pose_sequence(landmarks.reshape(len(landmarks), RAW_FEATURE_DIM))\n",
    "            frames, length = resize_sequence(norm, MAX_FRAMES)\n",
    "            loaded.append({**row, \"frames\": frames, \"length\": length})\n",
    "        except Exception as exc:\n",
    "            errors.append(f\"{row['uid']} ({row['path']}): {exc}\")\n",
    "    if errors:\n",
    "        print(f\"Invalid aligned pose samples: {len(errors)}\")\n",
    "        print(\"\\n\".join(errors[:20]))\n",
    "        raise ValueError(\"Translation validation failed; invalid samples were not discarded.\")\n",
    "    if not loaded:\n",
    "        raise ValueError(\"No valid pose-to-English pairs in split.\")\n",
    "    return loaded\n",
    "\n",
    "\n",
    "def prepare_translation_data():\n",
    "    if not CONFIRM_DATASET_RIGHTS:\n",
    "        raise PermissionError(\"Confirm attached dataset rights in configuration before training.\")\n",
    "    records, fmt = load_translation_records()\n",
    "    dataset_name = TRANSLATION_DATASET_NAME\n",
    "    dataset_license = TRANSLATION_LICENSE\n",
    "    if fmt == \"glosl\":\n",
    "        dataset_name, dataset_license = \"GloSL-ISL\", \"CC BY-NC 4.0\"\n",
    "    elif fmt == \"isign\":\n",
    "        dataset_name, dataset_license = \"iSign\", \"CC BY-NC-SA 4.0\"\n",
    "    if \"nc\" in dataset_license.lower() and not ALLOW_RESEARCH_ONLY_DATASETS:\n",
    "        raise PermissionError(f\"{dataset_name} is non-commercial/research-only. Set ALLOW_RESEARCH_ONLY_DATASETS=True only for research.\")\n",
    "    splits, signer_complete, policy = assign_translation_splits(records)\n",
    "    splits = {name: limit_split(rows, MAX_SAMPLES_PER_SPLIT, SEED + i)\n",
    "              for i, (name, rows) in enumerate(splits.items())}\n",
    "    loaded = {name: load_translation_split(rows) for name, rows in splits.items()}\n",
    "\n",
    "    video_sets = {name: {r[\"video_id\"] for r in rows} for name, rows in loaded.items()}\n",
    "    unique_targets = len({row[\"text\"] for name in loaded for row in loaded[name]})\n",
    "\n",
    "    # Preflight Summary\n",
    "    print(\"=\" * 70)\n",
    "    print(\"MODEL B: CONTINUOUS ISL-TO-ENGLISH TRANSLATION PREFLIGHT SUMMARY\")\n",
    "    print(\"=\" * 70)\n",
    "    print(f\"Total valid aligned pairs: {len(records):,}\")\n",
    "    print(f\"Unique English target sentences: {unique_targets:,}\")\n",
    "    print(f\"Samples per split: {', '.join(f'{k}={len(v)}' for k, v in loaded.items())}\")\n",
    "    print(f\"Signer / video overlap:\")\n",
    "    print(f\"  train & validation = {len(video_sets['train'] & video_sets['validation'])}\")\n",
    "    print(f\"  train & test = {len(video_sets['train'] & video_sets['test'])}\")\n",
    "    print(f\"  validation & test = {len(video_sets['validation'] & video_sets['test'])}\")\n",
    "    print(f\"Source format: {fmt}; Split policy: {policy}\")\n",
    "    print(f\"Feature dimensions: {loaded['train'][0]['frames'].shape} -> model input {RAW_FEATURE_DIM * 2}\")\n",
    "    print(f\"Dataset name: {dataset_name}; License: {dataset_license}\")\n",
    "    print(f\"Training mode: {TRAINING_MODE}; Scope: {TRAINING_SCOPE}\")\n",
    "    print(\"=\" * 70)\n",
    "\n",
    "    return loaded, signer_complete, policy, fmt, len(records), dataset_name, dataset_license\n",
    "\n",
    "\n",
    "def translation_token_ids(text, tokenizer):\n",
    "    tokens = [tokenizer.bos_id()] + tokenizer.encode(text, out_type=int) + [tokenizer.eos_id()]\n",
    "    tokens = tokens[:MAX_TOKENS]\n",
    "    if tokens[-1] != tokenizer.eos_id():\n",
    "        tokens[-1] = tokenizer.eos_id()\n",
    "    return tokens\n",
    "\n",
    "\n",
    "class TranslationDataset(Dataset):\n",
    "    def __init__(self, rows, tokenizer):\n",
    "        self.rows = rows\n",
    "        self.tokenizer = tokenizer\n",
    "    def __len__(self):\n",
    "        return len(self.rows)\n",
    "    def __getitem__(self, index):\n",
    "        row = self.rows[index]\n",
    "        return (torch.from_numpy(row[\"frames\"]), int(row[\"length\"]),\n",
    "                torch.tensor(translation_token_ids(row[\"text\"], self.tokenizer), dtype=torch.long),\n",
    "                row[\"text\"], row[\"uid\"])\n",
    "\n",
    "\n",
    "def translation_collate(batch):\n",
    "    poses, lengths, token_rows, texts, uids = zip(*batch)\n",
    "    poses = torch.stack(poses)\n",
    "    lengths = torch.tensor(lengths, dtype=torch.long)\n",
    "    max_len = max(len(row) for row in token_rows)\n",
    "    tokens = torch.full((len(batch), max_len), 0, dtype=torch.long)\n",
    "    for i, row in enumerate(token_rows):\n",
    "        tokens[i, :len(row)] = row\n",
    "    return poses, lengths, tokens[:, :-1], tokens[:, 1:].masked_fill(tokens[:, 1:] == 0, -100), list(texts), list(uids)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "translation-model",
   "metadata": {},
   "source": [
    "### Translation model, loss, and resume\n",
    "\n",
    "The encoder-decoder uses raw 1629-D frames; its frame projection concatenates frame deltas internally, matching backend input width 3258. Source padding mask uses true sequence lengths. Decoder uses causal and target-padding masks; PAD targets are excluded from cross-entropy. Tokenizer is trained only from training targets."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "translation-model-functions",
   "metadata": {},
   "outputs": [],
   "source": [
    "class FrameProjection(nn.Module):\n",
    "    def __init__(self, input_dim, d_model):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(input_dim, 384), nn.LayerNorm(384), nn.GELU(), nn.Dropout(0.10),\n",
    "            nn.Linear(384, d_model), nn.LayerNorm(d_model),\n",
    "        )\n",
    "        self.temporal = nn.Conv1d(d_model, d_model, kernel_size=5, padding=2, groups=d_model)\n",
    "    def forward(self, x):\n",
    "        delta = torch.zeros_like(x)\n",
    "        delta[:, 1:] = x[:, 1:] - x[:, :-1]\n",
    "        return self.temporal(self.net(torch.cat([x, delta], dim=-1)).transpose(1, 2)).transpose(1, 2)\n",
    "\n",
    "\n",
    "class PositionalEncoding(nn.Module):\n",
    "    def __init__(self, d_model, max_len):\n",
    "        super().__init__()\n",
    "        pos = torch.arange(max_len, dtype=torch.float32).unsqueeze(1)\n",
    "        div = torch.exp(torch.arange(0, d_model, 2, dtype=torch.float32) * (-math.log(10000.0) / d_model))\n",
    "        pe = torch.zeros(max_len, d_model)\n",
    "        pe[:, 0::2] = torch.sin(pos * div)\n",
    "        pe[:, 1::2] = torch.cos(pos * div)\n",
    "        self.register_buffer(\"pe\", pe.unsqueeze(0))\n",
    "    def forward(self, x):\n",
    "        return x + self.pe[:, :x.size(1)]\n",
    "\n",
    "\n",
    "class SignTransformer(nn.Module):\n",
    "    def __init__(self, input_dim, vocab_size, max_frames, max_tokens, pad_idx,\n",
    "                 d_model=128, nhead=4, layers=2, ff=512, dropout=0.15, norm_first=False):\n",
    "        super().__init__()\n",
    "        self.pad_idx = pad_idx\n",
    "        self.input_proj = FrameProjection(input_dim, d_model)\n",
    "        self.src_pos = PositionalEncoding(d_model, max_frames + 4)\n",
    "        self.tok_embed = nn.Embedding(vocab_size, d_model, padding_idx=pad_idx)\n",
    "        self.tgt_pos = PositionalEncoding(d_model, max_tokens + 4)\n",
    "        enc = nn.TransformerEncoderLayer(d_model, nhead, ff, dropout, batch_first=True, norm_first=norm_first)\n",
    "        dec = nn.TransformerDecoderLayer(d_model, nhead, ff, dropout, batch_first=True, norm_first=norm_first)\n",
    "        self.encoder = nn.TransformerEncoder(enc, layers)\n",
    "        self.decoder = nn.TransformerDecoder(dec, layers)\n",
    "        self.out = nn.Linear(d_model, vocab_size)\n",
    "        self.scale = d_model ** 0.5\n",
    "    def encode(self, frames, src_pad):\n",
    "        return self.encoder(self.src_pos(self.input_proj(frames)), src_key_padding_mask=src_pad)\n",
    "    def decode(self, tokens, memory, tgt_mask, src_pad, tgt_pad=None):\n",
    "        x = self.tgt_pos(self.tok_embed(tokens) * self.scale)\n",
    "        return self.out(self.decoder(x, memory, tgt_mask=tgt_mask,\n",
    "                    tgt_key_padding_mask=tgt_pad, memory_key_padding_mask=src_pad))\n",
    "    def forward(self, frames, src_pad, tokens, tgt_mask):\n",
    "        return self.decode(tokens, self.encode(frames, src_pad), tgt_mask, src_pad,\n",
    "                           tgt_pad=tokens.eq(self.pad_idx))\n",
    "\n",
    "\n",
    "def _tokenizer_fingerprint(model_path, tokenizer):\n",
    "    digest = hashlib.sha256(Path(model_path).read_bytes())\n",
    "    digest.update(str(tokenizer.get_piece_size()).encode())\n",
    "    digest.update(f\"{tokenizer.pad_id()},{tokenizer.unk_id()},{tokenizer.bos_id()},{tokenizer.eos_id()}\".encode())\n",
    "    return digest.hexdigest()[:16]\n",
    "\n",
    "\n",
    "def build_tokenizer(train_rows, directory, resume):\n",
    "    try:\n",
    "        import sentencepiece as spm\n",
    "    except ImportError as exc:\n",
    "        raise ImportError(\"Translation requires `pip install sentencepiece`.\") from exc\n",
    "    directory = Path(directory)\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "    model_path = directory / \"signsage_en_sp.model\"\n",
    "    metadata_path = directory / \"tokenizer_metadata.json\"\n",
    "    corpus_hash = hashlib.sha256(\"\\n\".join(row[\"text\"] for row in train_rows).encode()).hexdigest()\n",
    "    if resume:\n",
    "        if not model_path.is_file() or not metadata_path.is_file():\n",
    "            raise FileNotFoundError(\"Resume requested but tokenizer artifacts are missing.\")\n",
    "        meta = json.loads(metadata_path.read_text(encoding=\"utf-8\"))\n",
    "        if meta[\"training_text_sha256\"] != corpus_hash:\n",
    "            raise ValueError(\"Training text changed since checkpoint; refusing mismatched tokenizer resume.\")\n",
    "    else:\n",
    "        if model_path.exists():\n",
    "            raise FileExistsError(f\"Tokenizer already exists at {model_path}; resume or use a new output directory.\")\n",
    "        with tempfile.TemporaryDirectory() as temp_dir:\n",
    "            corpus = Path(temp_dir) / \"train.txt\"\n",
    "            corpus.write_text(\"\\n\".join(row[\"text\"].replace(\"\\n\", \" \") for row in train_rows) + \"\\n\", encoding=\"utf-8\")\n",
    "            spm.SentencePieceTrainer.train(\n",
    "                input=str(corpus), model_prefix=str(directory / \"signsage_en_sp\"),\n",
    "                vocab_size=SP_VOCAB_SIZE, model_type=\"unigram\", character_coverage=0.9995,\n",
    "                pad_id=0, unk_id=1, bos_id=2, eos_id=3, hard_vocab_limit=False,\n",
    "                shuffle_input_sentence=False, num_threads=1, minloglevel=2,\n",
    "            )\n",
    "        atomic_json_save({\"training_text_sha256\": corpus_hash}, metadata_path)\n",
    "    tokenizer = spm.SentencePieceProcessor(model_file=str(model_path))\n",
    "    actual = (tokenizer.pad_id(), tokenizer.unk_id(), tokenizer.bos_id(), tokenizer.eos_id())\n",
    "    if actual != (0, 1, 2, 3):\n",
    "        raise ValueError(f\"Unexpected SentencePiece special-token IDs: {actual}\")\n",
    "    return tokenizer, model_path\n",
    "\n",
    "\n",
    "def source_padding_mask(lengths, max_len):\n",
    "    return torch.arange(max_len, device=lengths.device).unsqueeze(0) >= lengths.unsqueeze(1)\n",
    "\n",
    "\n",
    "def causal_mask(size, device):\n",
    "    return torch.triu(torch.ones(size, size, dtype=torch.bool, device=device), diagonal=1)\n",
    "\n",
    "\n",
    "def _translation_loss_epoch(model, loader, optimizer=None):\n",
    "    training = optimizer is not None\n",
    "    model.train(training)\n",
    "    total_loss, total_tokens = 0.0, 0\n",
    "    grad_context = torch.enable_grad if training else torch.no_grad\n",
    "    with grad_context():\n",
    "        for poses, lengths, decoder_input, targets, _, _ in loader:\n",
    "            poses, lengths = poses.to(DEVICE), lengths.to(DEVICE)\n",
    "            decoder_input, targets = decoder_input.to(DEVICE), targets.to(DEVICE)\n",
    "            source_mask = source_padding_mask(lengths, poses.size(1))\n",
    "            logits = model(poses, source_mask, decoder_input, causal_mask(decoder_input.size(1), DEVICE))\n",
    "            loss = nn.functional.cross_entropy(logits.reshape(-1, logits.size(-1)), targets.reshape(-1), ignore_index=-100)\n",
    "            if training:\n",
    "                optimizer.zero_grad(set_to_none=True)\n",
    "                loss.backward()\n",
    "                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "                optimizer.step()\n",
    "            valid = int((targets != -100).sum())\n",
    "            total_loss += float(loss.item()) * valid\n",
    "            total_tokens += valid\n",
    "    return total_loss / max(total_tokens, 1)\n",
    "\n",
    "\n",
    "def _ban_ngram(logits, ids, n=3):\n",
    "    if n <= 1 or len(ids) < n - 1:\n",
    "        return logits\n",
    "    prefix = tuple(ids[-(n - 1):])\n",
    "    for start in range(len(ids) - n + 1):\n",
    "        gram = tuple(ids[start:start + n])\n",
    "        if gram[:-1] == prefix:\n",
    "            logits[gram[-1]] = -torch.inf\n",
    "    return logits\n",
    "\n",
    "\n",
    "@torch.inference_mode()\n",
    "def greedy_decode_batch(model, poses, lengths, tokenizer, max_new_tokens=MAX_TOKENS - 1):\n",
    "    model.eval()\n",
    "    poses, lengths = poses.to(DEVICE), lengths.to(DEVICE)\n",
    "    source_mask = source_padding_mask(lengths, poses.size(1))\n",
    "    memory = model.encode(poses, source_mask)\n",
    "    ids = torch.full((len(poses), 1), tokenizer.bos_id(), dtype=torch.long, device=DEVICE)\n",
    "    finished = torch.zeros(len(poses), dtype=torch.bool, device=DEVICE)\n",
    "    for step in range(max_new_tokens):\n",
    "        logits = model.decode(ids, memory, causal_mask(ids.size(1), DEVICE), source_mask)[:, -1].float()\n",
    "        logits[:, tokenizer.pad_id()] = -torch.inf\n",
    "        logits[:, tokenizer.bos_id()] = -torch.inf\n",
    "        logits[:, tokenizer.unk_id()] = -torch.inf\n",
    "        if step < 1:\n",
    "            logits[:, tokenizer.eos_id()] = -torch.inf\n",
    "        for i in range(len(ids)):\n",
    "            if finished[i]:\n",
    "                logits[i].fill_(-torch.inf)\n",
    "                logits[i, tokenizer.eos_id()] = 0.0\n",
    "            else:\n",
    "                _ban_ngram(logits[i], ids[i].tolist())\n",
    "                if not torch.isfinite(logits[i]).any():\n",
    "                    logits[i, tokenizer.eos_id()] = 0.0\n",
    "        next_ids = logits.argmax(dim=-1)\n",
    "        ids = torch.cat([ids, next_ids[:, None]], dim=1)\n",
    "        finished |= next_ids.eq(tokenizer.eos_id())\n",
    "        if bool(finished.all()):\n",
    "            break\n",
    "    blocked = {tokenizer.eos_id(), tokenizer.pad_id(), tokenizer.bos_id(), tokenizer.unk_id()}\n",
    "    return [tokenizer.decode([int(x) for x in row[1:] if int(x) not in blocked]) for row in ids]\n",
    "\n",
    "\n",
    "def _edit_distance(left, right):\n",
    "    previous = list(range(len(right) + 1))\n",
    "    for i, a in enumerate(left, 1):\n",
    "        current = [i]\n",
    "        for j, b in enumerate(right, 1):\n",
    "            current.append(min(current[-1] + 1, previous[j] + 1, previous[j - 1] + (a != b)))\n",
    "        previous = current\n",
    "    return previous[-1]\n",
    "\n",
    "\n",
    "def _lcs_length(a, b):\n",
    "    previous = [0] * (len(b) + 1)\n",
    "    for x in a:\n",
    "        current = [0]\n",
    "        for j, y in enumerate(b, 1):\n",
    "            current.append(previous[j - 1] + 1 if x == y else max(previous[j], current[-1]))\n",
    "        previous = current\n",
    "    return previous[-1]\n",
    "\n",
    "\n",
    "def translation_metrics(references, predictions):\n",
    "    refs = [str(x).lower().split() for x in references]\n",
    "    hyps = [str(x).lower().split() for x in predictions]\n",
    "    edits = sum(_edit_distance(r, h) for r, h in zip(refs, hyps))\n",
    "    ref_words = sum(len(r) for r in refs)\n",
    "    clipped, totals = [0] * 4, [0] * 4\n",
    "    for ref, hyp in zip(refs, hyps):\n",
    "        for n in range(1, 5):\n",
    "            ref_counts = Counter(tuple(ref[i:i+n]) for i in range(max(0, len(ref)-n+1)))\n",
    "            hyp_counts = Counter(tuple(hyp[i:i+n]) for i in range(max(0, len(hyp)-n+1)))\n",
    "            clipped[n-1] += sum(min(count, ref_counts[gram]) for gram, count in hyp_counts.items())\n",
    "            totals[n-1] += sum(hyp_counts.values())\n",
    "    precisions = [(clipped[i] + 1) / (totals[i] + 1) for i in range(4)]\n",
    "    hyp_words = sum(len(h) for h in hyps)\n",
    "    brevity = min(1.0, math.exp(1 - ref_words / max(hyp_words, 1)))\n",
    "    bleu = 100.0 * brevity * math.exp(sum(math.log(p) for p in precisions) / 4)\n",
    "    rouge = []\n",
    "    for ref, hyp in zip(refs, hyps):\n",
    "        common = _lcs_length(ref, hyp)\n",
    "        p = common / len(hyp) if hyp else 0.0\n",
    "        r = common / len(ref) if ref else 0.0\n",
    "        rouge.append(2 * p * r / (p + r) if p + r else 0.0)\n",
    "    normalized = [\" \".join(x) for x in hyps]\n",
    "    frequency = Counter(normalized)\n",
    "    diversity = len(frequency) / max(len(normalized), 1)\n",
    "    return {\n",
    "        \"wer\": edits / max(ref_words, 1),\n",
    "        \"bleu4\": bleu,\n",
    "        \"rouge_l\": float(np.mean(rouge)) if rouge else 0.0,\n",
    "        \"prediction_diversity\": diversity,\n",
    "        \"top_prediction_frequency\": max(frequency.values(), default=0) / max(len(normalized), 1),\n",
    "        \"collapsed\": diversity < 0.05 or (max(frequency.values(), default=0) / max(len(normalized), 1) > 0.5),\n",
    "        \"samples\": len(refs),\n",
    "    }\n",
    "\n",
    "\n",
    "def evaluate_translation(model, loader, tokenizer):\n",
    "    references, predictions, examples = [], [], []\n",
    "    for poses, lengths, _, _, texts, uids in loader:\n",
    "        decoded = greedy_decode_batch(model, poses, lengths, tokenizer)\n",
    "        references.extend(texts)\n",
    "        predictions.extend(decoded)\n",
    "        for uid, reference, prediction in zip(uids, texts, decoded):\n",
    "            if len(examples) < 8:\n",
    "                examples.append({\"uid\": uid, \"reference\": reference, \"prediction\": prediction})\n",
    "    return translation_metrics(references, predictions), examples\n",
    "\n",
    "\n",
    "def train_translation():\n",
    "    loaded, signer_complete, split_policy, fmt, available_rows, dataset_name, dataset_license = prepare_translation_data()\n",
    "    output = OUTPUT_ROOT / \"translation\"\n",
    "    output.mkdir(parents=True, exist_ok=True)\n",
    "    checkpoint_dir = output / \"checkpoint\"\n",
    "    tokenizer_dir = output / \"tokenizer\"\n",
    "    state_path = output / \"training_state.pt\"\n",
    "    best_path = checkpoint_dir / \"signsage_transformer_full.pt\"\n",
    "    if RESUME_TRANSLATION:\n",
    "        if not state_path.is_file():\n",
    "            raise FileNotFoundError(f\"Resume requested but no recovery checkpoint exists: {state_path}\")\n",
    "    elif state_path.exists() or best_path.exists() or (tokenizer_dir / \"signsage_en_sp.model\").exists():\n",
    "        raise FileExistsError(f\"Output exists at {output}; resume or choose a fresh output directory.\")\n",
    "    tokenizer, tokenizer_path = build_tokenizer(loaded[\"train\"], tokenizer_dir, RESUME_TRANSLATION)\n",
    "    loaders = {\n",
    "        name: DataLoader(TranslationDataset(rows, tokenizer), batch_size=BATCH_SIZE,\n",
    "                         shuffle=name == \"train\", num_workers=0, collate_fn=translation_collate)\n",
    "        for name, rows in loaded.items()\n",
    "    }\n",
    "    model_config = {\n",
    "        \"input_dim\": RAW_FEATURE_DIM * 2, \"raw_feature_dim\": RAW_FEATURE_DIM,\n",
    "        \"vocab_size\": tokenizer.get_piece_size(), \"max_frames\": MAX_FRAMES, \"max_tokens\": MAX_TOKENS,\n",
    "        \"d_model\": MODEL_DIM, \"nhead\": ATTENTION_HEADS, \"layers\": TRANSFORMER_LAYERS,\n",
    "        \"ff\": FEED_FORWARD_DIM, \"dropout\": 0.15, \"norm_first\": False,\n",
    "        \"training_scope\": TRAINING_SCOPE,\n",
    "    }\n",
    "    model = SignTransformer(\n",
    "        input_dim=model_config[\"input_dim\"], vocab_size=model_config[\"vocab_size\"],\n",
    "        max_frames=MAX_FRAMES, max_tokens=MAX_TOKENS, pad_idx=tokenizer.pad_id(),\n",
    "        d_model=MODEL_DIM, nhead=ATTENTION_HEADS, layers=TRANSFORMER_LAYERS,\n",
    "        ff=FEED_FORWARD_DIM, dropout=0.15, norm_first=False,\n",
    "    ).to(DEVICE)\n",
    "    optimizer = torch.optim.AdamW(model.parameters(), lr=LEARNING_RATE)\n",
    "    history, best_val, start_epoch = [], float(\"inf\"), 0\n",
    "    data_fingerprint = fingerprint_rows(\n",
    "        [row for name in (\"train\", \"validation\", \"test\") for row in loaded[name]],\n",
    "        (\"uid\", \"text\", \"path\", \"video_id\", \"signer\"),\n",
    "    )\n",
    "    training_config = {\"batch_size\": BATCH_SIZE, \"learning_rate\": LEARNING_RATE,\n",
    "                       \"seed\": SEED, \"max_samples_per_split\": MAX_SAMPLES_PER_SPLIT,\n",
    "                       \"training_mode\": TRAINING_MODE, \"training_scope\": TRAINING_SCOPE}\n",
    "    if RESUME_TRANSLATION:\n",
    "        state = torch.load(state_path, map_location=DEVICE, weights_only=True)\n",
    "        if (state[\"model_config\"] != model_config\n",
    "                or state[\"data_fingerprint\"] != data_fingerprint\n",
    "                or state[\"training_config\"] != training_config):\n",
    "            raise ValueError(\"Translation data, model, or training config differs from recovery checkpoint.\")\n",
    "        model.load_state_dict(state[\"state_dict\"])\n",
    "        optimizer.load_state_dict(state[\"optimizer\"])\n",
    "        history, best_val, start_epoch = state[\"history\"], state[\"best_val\"], state[\"epoch\"] + 1\n",
    "        restore_rng_state(state)\n",
    "    if EPOCHS <= 0:\n",
    "        raise ValueError(\"EPOCHS must be positive.\")\n",
    "    for epoch in range(start_epoch, EPOCHS):\n",
    "        train_loss = _translation_loss_epoch(model, loaders[\"train\"], optimizer)\n",
    "        val_loss = _translation_loss_epoch(model, loaders[\"validation\"])\n",
    "        row = {\"epoch\": epoch + 1, \"train_loss\": train_loss, \"validation_loss\": val_loss}\n",
    "        history.append(row)\n",
    "        if val_loss < best_val:\n",
    "            best_val = val_loss\n",
    "            payload = {\"state_dict\": model.state_dict(), \"model_config\": model_config,\n",
    "                       \"tokenizer_fingerprint\": _tokenizer_fingerprint(tokenizer_path, tokenizer)}\n",
    "            atomic_torch_save(payload, best_path)\n",
    "        atomic_torch_save({\n",
    "            \"state_dict\": model.state_dict(), \"optimizer\": optimizer.state_dict(),\n",
    "            \"epoch\": epoch, \"best_val\": best_val, \"history\": history,\n",
    "            \"model_config\": model_config, \"data_fingerprint\": data_fingerprint,\n",
    "            \"training_config\": training_config, **capture_rng_state(),\n",
    "        }, state_path)\n",
    "        print(row)\n",
    "    model.load_state_dict(torch.load(best_path, map_location=DEVICE, weights_only=True)[\"state_dict\"])\n",
    "    test_metrics, examples = evaluate_translation(model, loaders[\"test\"], tokenizer)\n",
    "    report = {\n",
    "        \"status\": \"EXPERIMENTAL_NOT_PROMOTED\", \"scope\": TRAINING_SCOPE,\n",
    "        \"training_mode\": TRAINING_MODE,\n",
    "        \"dataset\": dataset_name, \"license\": dataset_license,\n",
    "        \"source_format\": fmt, \"signer_independent\": signer_complete,\n",
    "        \"split_policy\": split_policy, \"available_rows\": available_rows,\n",
    "        \"rows_used\": {name: len(rows) for name, rows in loaded.items()},\n",
    "        \"test_metrics\": test_metrics, \"examples\": examples,\n",
    "        \"prediction_diversity_warning\": test_metrics[\"collapsed\"],\n",
    "        \"avatar_signing_solved\": False,\n",
    "    }\n",
    "    atomic_json_save(report, output / \"evaluation_report.json\")\n",
    "    atomic_json_save(history, output / \"training_history.json\")\n",
    "    atomic_json_save(model_config, output / \"model_config.json\")\n",
    "    atomic_json_save({\n",
    "        \"total_landmark_count\": TOTAL_LANDMARKS, \"coordinates_per_landmark\": 3,\n",
    "        \"source_shape\": [None, TOTAL_LANDMARKS, 3], \"raw_feature_dim\": RAW_FEATURE_DIM,\n",
    "        \"component_order\": COMPONENT_ORDER, \"component_ranges\": COMPONENT_RANGES,\n",
    "        \"coordinate_order\": [\"x\", \"y\", \"z\"], \"normalization_version\": \"pose_normalize_v1\",\n",
    "        \"max_frames\": MAX_FRAMES, \"final_model_input_dim\": RAW_FEATURE_DIM * 2,\n",
    "        \"full_feature_mask\": [1] * RAW_FEATURE_DIM,\n",
    "    }, output / \"landmark_contract.json\")\n",
    "    atomic_json_save({\n",
    "        \"feature_dim\": RAW_FEATURE_DIM, \"model_input_dim\": RAW_FEATURE_DIM * 2,\n",
    "        \"max_frames\": MAX_FRAMES, \"max_tokens\": MAX_TOKENS,\n",
    "        \"vocab_size\": tokenizer.get_piece_size(),\n",
    "        \"special_token_ids\": {\"pad\": tokenizer.pad_id(), \"unk\": tokenizer.unk_id(),\n",
    "                              \"bos\": tokenizer.bos_id(), \"eos\": tokenizer.eos_id()},\n",
    "        \"normalization_version\": \"pose_normalize_v1\",\n",
    "        \"tokenizer_model\": \"tokenizer/signsage_en_sp.model\",\n",
    "        \"checkpoint\": \"checkpoint/signsage_transformer_full.pt\",\n",
    "        \"decoding\": {\"max_decode_tokens\": MAX_TOKENS - 1, \"min_output_tokens\": 1,\n",
    "                     \"no_repeat_ngram_size\": 3, \"repetition_penalty\": 1.0},\n",
    "    }, output / \"sign_to_text_deployment.json\")\n",
    "    print(\"Translation held-out test:\", test_metrics)\n",
    "    if test_metrics[\"collapsed\"]:\n",
    "        print(\"Warning: repetitive/collapsed output detected; do not present as generalization.\")\n",
    "    return report\n",
    "\n",
    "\n",
    "if TRAIN_TRANSLATION:\n",
    "    TRANSLATION_REPORT = train_translation()\n",
    "else:\n",
    "    print(\"Model B training disabled. Attach aligned pose/text data and explicitly enable TRAIN_TRANSLATION.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "metrics",
   "metadata": {},
   "source": [
    "## 6. Evaluation and export\n",
    "\n",
    "Recognition reports training/validation/test separately, including macro metrics and confusion matrix. Translation reports teacher-forced loss curves and held-out WER, corpus BLEU-4, ROUGE-L, output diversity, and examples. Test data never selects checkpoints. No signer-independent generalization claim is made when signer IDs are absent.\n",
    "\n",
    "## 7–8. Backend integration\n",
    "\n",
    "- Recognition export follows `backend/app/ml/isolated_words.py`: `model.pt`, `labels.json`, `metadata.json`, `evaluation_results.json`, and matching feature config. Load with `IsolatedWordAdapter.load(\"outputs/recognition\")`; call `adapter.transcribe(raw_landmarks_543)`. Existing confidence/motion rejection remains in backend.\n",
    "- Translation export follows `SignToTextAdapter`: `checkpoint/signsage_transformer_full.pt`, `tokenizer/signsage_en_sp.model`, `landmark_contract.json`, and `sign_to_text_deployment.json`. Load with `SignToTextAdapter.load(\"outputs/translation\")`; call `adapter.transcribe(raw_landmarks_543, min_motion=0.002, min_confidence=0.0)`. Existing acceptance/rejection behavior remains unchanged.\n",
    "- Both bundles are marked experimental/pilot and not promotion-ready. No backend/frontend files change. Neither model solves avatar signing. Raw videos are not copied to outputs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "synthetic-smoke",
   "metadata": {},
   "outputs": [],
   "source": [
    "def synthetic_smoke_check():\n",
    "    torch.manual_seed(SEED)\n",
    "    # Recognition forward/backward on canonical feature shape.\n",
    "    recognition = IsolatedWordNet(3).to(DEVICE)\n",
    "    x = torch.randn(2, 64, 225, device=DEVICE)\n",
    "    y = torch.tensor([0, 2], device=DEVICE)\n",
    "    loss_a = nn.functional.cross_entropy(recognition(x), y)\n",
    "    loss_a.backward()\n",
    "    assert torch.isfinite(loss_a)\n",
    "    # Translation forward/backward with source + causal + target padding masks.\n",
    "    translation = SignTransformer(input_dim=32, vocab_size=12, max_frames=8, max_tokens=6,\n",
    "                                  pad_idx=0, d_model=32, nhead=4, layers=1, ff=64).to(DEVICE)\n",
    "    poses = torch.randn(2, 8, 16, device=DEVICE)\n",
    "    lengths = torch.tensor([8, 5], device=DEVICE)\n",
    "    src_mask = source_padding_mask(lengths, poses.size(1))\n",
    "    tokens = torch.tensor([[2, 4, 5], [2, 6, 0]], device=DEVICE)\n",
    "    logits = translation(poses, src_mask, tokens, causal_mask(tokens.size(1), DEVICE))\n",
    "    target = torch.tensor([[4, 5, 3], [6, 3, -100]], device=DEVICE)\n",
    "    loss_b = nn.functional.cross_entropy(logits.reshape(-1, 12), target.reshape(-1), ignore_index=-100)\n",
    "    loss_b.backward()\n",
    "    assert logits.shape == (2, 3, 12) and torch.isfinite(loss_b)\n",
    "    print(f\"Synthetic smoke passed: recognition_loss={loss_a.item():.4f}, translation_loss={loss_b.item():.4f}\")\n",
    "\n",
    "\n",
    "if RUN_SYNTHETIC_SMOKE:\n",
    "    synthetic_smoke_check()"
   ]
  },
